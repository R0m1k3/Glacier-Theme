<script>
function glacierAccent(value) {
  document.getElementById('glacier-accent').value = value;
  if (value) document.getElementById('glacier-accent-pick').value = value;
  $('#glacier-accent').trigger('change');
}
document.getElementById('glacier-accent-pick').addEventListener('input', function () {
  glacierAccent(this.value);
});
</script>
