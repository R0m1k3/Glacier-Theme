?>
<script>window.glacierFavourites = <?= json_encode(['enabled' => $glacierFavEnabled, 'list' => $glacierFavList], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES) ?>;</script>
